# This project's identity for the build scripts (bash and PowerShell both read it): the only place these names live.
# The version is NOT here: edit ../VERSION (or run build/version.sh X.Y.Z) and every consumer follows.
KB_PROJECT_TITLE="KrankyBear GitExplorer"
KB_FPM_NAME="kbgitexplorer"              # bin/${KB_FPM_NAME}-macos-arm64, -macos-amd64, -linux-amd64, -linux-arm64
KB_WINDOWS_EXE="KrankyBearGitExplorer.exe"        # bin/<this>
KB_MAC_ICON="assets/images/KrankyBearNerd.png"
KB_DEV_BINARY="gitexplorer"                       # what build/buildrun.sh builds and runs
KB_HOMEPAGE="https://github.com/amarillier/KrankyBearGitExplorer"
KB_VENDOR="Allan Marillier"
KB_LICENSE="GPL v3"
