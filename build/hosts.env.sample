# Build host settings for build/compile-all.sh and the sync scripts. Copy to build/hosts.env (git-ignored) and edit.
# Leave a section empty to skip that platform. Nothing in here is committed. $PROJECT_DIR is this project's folder name.

# Linux build host (Ubuntu or Debian family, ssh key login; needs Go, gcc and the X11/GL dev packages: build/compile-linux.sh lists
# or installs what is missing). The aarch64 cross-compiler gives the arm64 build.
UBUNTU_USER=
UBUNTU_HOST=
UBUNTU_PATH=/home/$UBUNTU_USER/$PROJECT_DIR

# Windows build host (OpenSSH + Go + MSYS2 gcc: the GUI needs cgo so it is built natively there).
WINDOWS_USER=
WINDOWS_HOST=
WINDOWS_PATH='C:\Allan\Source\go\'$PROJECT_DIR

# How the source gets to Windows: an SMB share mounted on this Mac (fast rsync; the built exe comes back through it), or empty to copy over ssh.
#   WINDOWS_SHARE_SMB   what to mount, e.g. //user@host/Share
#   WINDOWS_SHARE_MOUNT where it is (or will be) mounted on this Mac, e.g. $HOME/WinShare
#   WINDOWS_SHARE_PATH  the project folder inside the share, e.g. Allan/Source/go/$PROJECT_DIR
WINDOWS_SHARE_SMB=
WINDOWS_SHARE_MOUNT=
WINDOWS_SHARE_PATH=

# Optional ssh key for the hosts above.
SSH_KEY=
