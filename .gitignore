## Build artifacts
bin/.DS_Store
assets/
dist/
vendor/*
sync*.sh
compile*.sh
compile*.bat
compile*.ps1
*.ps1
setver.sh
rename-app.sh
*.sh

# dep-scan helper scripts — tracked despite the *.sh and *.ps1 broad excludes
# so teammates who clone the repo get them out-of-the-box.
!dep-scan.sh
!dep-scan.ps1
rsrc_windows_amd64.syso
kbgitexplorer
gitexplorer
REUSABLE-DIALOGS-GUIDE.md
WINDOWS-SSH-SETUP.md

# ALLOWED
bin/*
installers/*
!assets/
Inno/*

# Build host details and retired scripts (see build/)
/build/hosts.env
/build/legacy/

# Mesa3D software-OpenGL DLLs (*.dll above) are fetched by build/tools/get-mesa.sh; its download scratch space is never committed.
/mesa-staging/

# Mesa3D fallback: its helper scripts are tracked (with the version pin, licence texts and markers in assets/mesa-win);
# build scripts, the DLLs and the download scratch space are not.
!/build/tools/get-mesa.sh
!/build/tools/check_mesa_updates.sh
!/build/tools/fetch_mesa_licenses.sh
